---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Mission from '../components/start/Mission.astro';
import Formate from '../components/start/Formate.astro';
import Angebote from '../components/start/Angebote.astro';
import About from '../components/About.astro';
import Referenzen from '../components/start/Referenzen.astro';
import Aktuelles from '../components/start/Aktuelles.astro';
import Kontakt from '../components/Kontakt.astro';
import Footer from '../components/Footer.astro';

const lang = 'de';
---
<BaseLayout lang={lang}>
  <Nav lang={lang} />
  <main>
    <Hero lang={lang} />
    <Mission />
    <Formate />
    <Angebote />
    <About lang={lang} />
    <Referenzen />
    <Aktuelles />
    <Kontakt lang={lang} />
  </main>
  <Footer lang={lang} />
</BaseLayout>
