---
// Formate (#formate) — deutsche Startseite. Inhalte: src/data/formate.ts
// Collagen: src/assets/formate/<bild> (4:5). Fehlt eine Datei, erscheint ein Platzhalter.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { formate, formateIntro, massgeschneidert } from '../../data/formate';

const collagen = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/formate/*.{jpg,jpeg,png,webp}',
  { eager: true },
);
const bildFuer = (datei: string) => collagen[`../../assets/formate/${datei}`]?.default;

const ext = (href: string) =>
  /^https?:\/\//.test(href) ? { target: '_blank', rel: 'noopener noreferrer' } : {};
---
<section class="section formate" id="formate">
  <div class="formate-head">
    <h2 class="formate-headline">Formate</h2>
    <p class="formate-intro">{formateIntro}</p>
  </div>

  <nav class="formate-jump" aria-label="Formate im Überblick">
    <ul>
      {formate.map((f) => (
        <li><a href={`#format-${f.id}`}>{f.titel}</a></li>
      ))}
    </ul>
  </nav>

  <ol class="formate-list">
    {formate.map((f) => {
      const bild = bildFuer(f.bild);
      return (
        <li class="format" id={`format-${f.id}`}>
          <div class="format-img">
            {bild ? (
              <Image
                src={bild}
                alt={f.bildAlt}
                widths={[360, 540, 720]}
                sizes="(max-width: 880px) 90vw, 40vw"
                format="webp"
                quality={85}
                loading="lazy"
              />
            ) : (
              <div class="img-placeholder" role="img" aria-label={f.bildAlt}>Collage folgt</div>
            )}
          </div>
          <div class="format-text">
            <p class="format-kicker">{f.kicker}</p>
            <h3 class="format-title">{f.titel}</h3>
            <p class="format-sub">{f.untertitel}</p>
            <p class="format-question">{f.leitfrage}</p>
            <p class="format-desc">{f.beschreibung}</p>
            <dl class="format-facts">
              <div><dt>Zielgruppe</dt><dd>{f.zielgruppe}</dd></div>
              {f.dauer && <div><dt>Dauer</dt><dd>{f.dauer}</dd></div>}
              <div><dt>Ergebnis</dt><dd>{f.ergebnis}</dd></div>
            </dl>
            <p class="format-links">
              <a class="btn btn--outline" href="#kontakt">Format anfragen <span aria-hidden="true">→</span></a>
              {f.link && (
                <a class="link" href={f.link} {...ext(f.link)}>Mehr erfahren <span aria-hidden="true">→</span></a>
              )}
            </p>
          </div>
        </li>
      );
    })}
  </ol>

  <aside class="formate-custom" aria-labelledby="formate-custom-title">
    <h3 id="formate-custom-title">{massgeschneidert.titel}</h3>
    {massgeschneidert.absaetze.map((p) => <p>{p}</p>)}
    <a class="btn btn--light formate-custom-btn" href="#kontakt">{massgeschneidert.button} <span aria-hidden="true">→</span></a>
  </aside>
</section>

<style>
  .formate-head { max-width: 820px; }
  .formate-headline {
    font-size: var(--fs-headline);
    margin-bottom: clamp(20px, 3vw, 32px);
  }
  .formate-intro {
    font-size: clamp(1.125rem, 1.5vw, 1.25rem);
    line-height: var(--lh-body);
    color: var(--ink-2);
    max-width: 64ch;
  }

  /* Jump bar — the six titles as anchor links. */
  .formate-jump { margin: clamp(32px, 5vw, 56px) 0 clamp(48px, 7vw, 96px); }
  .formate-jump ul {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .formate-jump a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 20px;
    border: 1.5px solid var(--ink);
    border-radius: var(--radius-pill);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--ink);
    transition: background var(--dur-fast) var(--ease-std), color var(--dur-fast) var(--ease-std);
  }
  .formate-jump a:hover { background: var(--ink); color: var(--paper); opacity: 1; }
  .formate-jump a:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

  /* Entries: two columns, image side alternates. The blue line runs down
     the middle of the column gap, so it never crosses text or images. */
  .formate-list {
    --col-gap: clamp(56px, 8vw, 128px);
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .formate-list::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 1px;
    background: var(--accent);
    transform: translateX(-0.5px);
  }
  .format {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: var(--col-gap);
    align-items: start;
    padding-bottom: clamp(64px, 9vw, 128px);
    scroll-margin-top: 80px;
  }
  .format:last-child { padding-bottom: 0; }
  /* Dot on the line at the top of each entry. */
  .format::before {
    content: '';
    position: absolute;
    top: 6px;
    left: 50%;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 5px var(--paper);
    transform: translateX(-50%);
  }
  .format:nth-child(even) .format-img { order: 2; }

  .format-img {
    position: relative;
    aspect-ratio: 4 / 5;
    background: var(--paper-2);
    overflow: hidden;
  }
  .format-img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .format-kicker {
    font-family: var(--sans);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 16px;
  }
  .format-title {
    font-size: clamp(2rem, 3.6vw, 3rem);
    line-height: 1.1;
    margin: 0 0 10px;
  }
  .format-sub {
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(1.125rem, 1.6vw, 1.375rem);
    line-height: 1.3;
    color: var(--ink-2);
    margin: 0 0 clamp(20px, 2.5vw, 28px);
  }
  .format-question {
    font-weight: 600;
    font-size: var(--fs-body);
    line-height: var(--lh-normal);
    color: var(--ink);
  }
  .format-desc {
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--ink-2);
  }
  .format-facts {
    margin: 24px 0;
    border-top: 1px solid var(--rule-soft);
  }
  .format-facts > div {
    display: grid;
    grid-template-columns: 110px 1fr;
    gap: 16px;
    padding: 12px 0;
    border-bottom: 1px solid var(--rule-soft);
  }
  .format-facts dt {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    padding-top: 3px;
  }
  .format-facts dd {
    margin: 0;
    font-size: 15px;
    line-height: 1.5;
    color: var(--ink-2);
  }
  .format-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 28px;
    margin: 0;
  }
  .format-links { align-items: center; }
  .format-links a.link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--serif);
    font-size: 17px;
    border-bottom: 0;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  /* Custom training box — the accent blue as a solid panel, white text. */
  .formate-custom {
    margin-top: clamp(72px, 10vw, 140px);
    background: var(--accent);
    color: var(--paper);
    padding: clamp(32px, 5vw, 64px);
    border-radius: var(--radius-panel);
  }
  .formate-custom h3 {
    font-size: clamp(1.75rem, 3.2vw, 2.75rem);
    margin: 0 0 clamp(16px, 2vw, 24px);
  }
  .formate-custom p {
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    max-width: 64ch;
  }
  .formate-custom-btn { margin-top: 12px; }

  @media (max-width: 880px) {
    .formate-list::before,
    .format::before { display: none; }
    .format {
      grid-template-columns: 1fr;
      row-gap: 28px;
    }
    /* Stacked: image first, text below — for every entry. */
    .format:nth-child(even) .format-img { order: 0; }
    .format-img { max-width: 480px; }
  }
  @media (max-width: 540px) {
    .format-facts > div { grid-template-columns: 1fr; gap: 4px; }
  }
</style>
