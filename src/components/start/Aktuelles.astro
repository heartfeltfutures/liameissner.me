---
// Aktuelles (#aktuell) — deutsche Startseite. Einträge: translations.ts → de.aktuell.cards
// (dieselbe Quelle wie bisher). Optionales Feld `bild`: Dateiname in src/assets/aktuelles/
// (Hochformat 4:5). Ohne Bild erscheint eine einfarbige Fläche.
// Die englische Seite nutzt weiterhin src/components/Aktuell.astro.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { t } from '../../i18n/translations';

const copy = t('de').aktuell;
const items = copy.cards;

const bilder = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/aktuelles/*.{jpg,jpeg,png,webp}',
  { eager: true },
);
const bildFuer = (datei?: string) => (datei ? bilder[`../../assets/aktuelles/${datei}`]?.default : undefined);

// Flat fallback surfaces in the site's blue and grey tones, cycled per entry.
const flaechen = ['var(--accent)', 'var(--navy)', 'var(--muted)'];

// < 3 entries → static centered row. Otherwise a CSS marquee: the full list is
// repeated so translateX(-50%) always lands on a copy boundary — 4 copies for
// 3–5 entries, 2 copies from 6 on. Only the first copy is real; the others are
// aria-hidden and out of the tab order.
const isMarquee = items.length >= 3;
const copies = isMarquee ? (items.length <= 5 ? 4 : 2) : 1;
const groups = Array.from({ length: copies }, (_, g) => g);
---
{items.length > 0 && (
  <section class="news" id="aktuell" aria-labelledby="news-heading">
    <div class="news-head">
      <h2 class="news-headline" id="news-heading">{copy.headline}</h2>
    </div>

    <div class:list={['news-marquee-wrap', { 'is-static': !isMarquee }]}>
      {isMarquee && (
        <button type="button" class="news-arrow news-arrow-prev" aria-label={copy.prevLabel}>←</button>
      )}
      <div class="news-marquee" role="region" aria-label={copy.carouselLabel} tabindex="0">
        <div class="news-track">
          {groups.map((g) => (
            <div class="news-group" aria-hidden={g > 0 ? 'true' : undefined}>
              {items.map((card, i) => {
                const bild = bildFuer(card.bild);
                return (
                  <a
                    class="news-card"
                    href={card.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    tabindex={g > 0 ? '-1' : undefined}
                  >
                    <div class="news-image" style={bild ? undefined : `background: ${flaechen[i % flaechen.length]}`}>
                      {bild && (
                        <Image src={bild} alt="" widths={[300, 600]} sizes="(max-width: 760px) 220px, 18vw" format="webp" loading={g === 0 && i < 3 ? 'eager' : 'lazy'} />
                      )}
                    </div>
                    <p class="news-title">{card.kategorie.toUpperCase()}: {card.titel}</p>
                    <p class="news-date">{card.datum}</p>
                  </a>
                );
              })}
            </div>
          ))}
        </div>
      </div>
      {isMarquee && (
        <button type="button" class="news-arrow news-arrow-next" aria-label={copy.nextLabel}>→</button>
      )}
    </div>
  </section>
)}

<style>
  .news {
    padding: clamp(60px, 9vw, 120px) 0;
    border-top: 1px solid var(--rule-soft);
  }
  .news-head {
    padding: 0 var(--pad-x);
    margin-bottom: clamp(32px, 5vw, 56px);
    text-align: center;
  }
  .news-headline {
    font-size: clamp(2.5rem, 6vw, 5rem);
    line-height: 1.1;
  }

  /* The wrap is the arrows' containing block — they sit outside the
     marquee's overflow/mask so they are never clipped. */
  .news-marquee-wrap { position: relative; }

  .news-marquee {
    overflow: hidden;
    width: 100%;
    mask-image: linear-gradient(to right, transparent 0, black 5%, black 95%, transparent 100%);
  }
  .news-marquee:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }
  .news-track {
    display: flex;
    gap: clamp(1rem, 2vw, 2rem);
    width: fit-content;
    animation: news-scroll 60s linear infinite;
  }
  .news-marquee:hover .news-track,
  .news-marquee:focus-within .news-track {
    animation-play-state: paused;
  }
  /* display:contents so the copy wrappers (which carry aria-hidden) don't
     break the flex gap rhythm — the cards become direct flex items. */
  .news-group { display: contents; }
  @keyframes news-scroll {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  /* < 3 entries: static centered row, no animation, no mask. */
  .is-static .news-marquee { mask-image: none; }
  .is-static .news-track {
    animation: none;
    width: auto;
    flex-wrap: wrap;
    justify-content: center;
    padding: 0 var(--pad-x);
  }

  /* After the first arrow/keyboard/touch use: bounded native scroller (same
     mechanism as reduced motion below). Toggled in src/scripts/site.js. */
  .news-marquee:global(.is-manual) {
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .news-marquee:global(.is-manual)::-webkit-scrollbar { display: none; }
  .news-marquee:global(.is-manual) .news-track { animation: none; }
  .news-marquee:global(.is-manual) .news-group[aria-hidden="true"] { display: none; }
  .news-marquee:global(.is-manual) .news-card { scroll-snap-align: start; }

  /* Arrows in the existing carousel style (square, hairline border). */
  .news-arrow {
    position: absolute;
    top: 40%;
    transform: translateY(-50%);
    z-index: 2;
    width: 44px;
    height: 44px;
    border: 1px solid var(--rule);
    background: var(--paper);
    color: var(--ink);
    font-family: var(--sans);
    font-size: 18px;
    cursor: pointer;
    transition: color .15s ease, border-color .15s ease;
  }
  .news-arrow-prev { left: 8px; }
  .news-arrow-next { right: 8px; }
  .news-arrow:hover { color: var(--accent); border-color: var(--accent); }
  .news-arrow:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .news-arrow:disabled {
    opacity: 0.35;
    cursor: default;
    pointer-events: none;
  }

  .news-card {
    flex-shrink: 0;
    width: clamp(220px, 18vw, 300px);
    display: block;
    color: var(--ink);
    border-radius: var(--radius-card);
  }
  .news-card:hover { opacity: 1; }
  .news-image {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-card);
    overflow: hidden;
    background: var(--paper-2);
    transition: filter var(--dur) var(--ease-std);
  }
  .news-image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .news-card:hover .news-image { filter: brightness(1.08); }
  .news-card:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }
  .news-title {
    font-family: var(--serif);
    font-size: 1.125rem;
    line-height: 1.35;
    margin: 1rem 0 0;
    max-width: none;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .news-date {
    font-size: 12px;
    letter-spacing: 0.08em;
    color: var(--muted);
    margin: 6px 0 0;
  }

  @media (max-width: 760px) {
    .news-arrow { display: none; }
    .news-marquee { mask-image: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .news-track { animation: none; }
    .news-marquee {
      overflow-x: auto;
      scroll-snap-type: x mandatory;
    }
    .news-card { scroll-snap-align: start; }
    /* Copies only feed the animation loop — drop them when it's off. */
    .news-group[aria-hidden="true"] { display: none; }
  }
</style>
