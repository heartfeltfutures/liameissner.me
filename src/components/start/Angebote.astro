---
// Meine Angebote (#angebote) — deutsche Startseite. Inhalte: src/data/angebote.ts
// Layout wie das Angebots-Akkordeon auf liferepairkit.de: dunkles Band,
// mitlaufende Überschrift links, aufklappbare Einträge rechts.
// Native <details>, beim Laden alle geöffnet — funktioniert ohne JavaScript.
import { angebote, angeboteHeadline } from '../../data/angebote';
---
<section class="offers" id="angebote" aria-labelledby="offers-heading">
  {/* Alias for the former "Meine Arbeit" anchor so old links (/#arbeit) land here. */}
  <span id="arbeit" class="offers-alias" aria-hidden="true"></span>
  <div class="offers-grid">
    <div class="offers-intro">
      <h2 class="offers-headline" id="offers-heading">{angeboteHeadline}</h2>
    </div>
    <div class="offers-list">
      {angebote.map((a) => (
        <details class="offers-item" open>
          <summary class="offers-summary">
            <span class="offers-titles">
              <h3 class="offers-title">{a.titel}</h3>
              <span class="offers-for">{a.fuer}</span>
            </span>
            <svg class="offers-chevron" aria-hidden="true" width="20" height="20" viewBox="0 0 20 20" fill="none">
              <path d="M5 7.5L10 12.5L15 7.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </summary>
          <div class="offers-body">
            <p>{a.text}</p>
            <a class="offers-cta" href={a.link.href}>{a.link.label} <span aria-hidden="true">→</span></a>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  /* Full-bleed, vw-based padding — deliberately no centered container. */
  .offers {
    position: relative;
    background: var(--indigo);
    color: var(--white);
    padding: 12vh 8vw;
  }
  .offers-alias { position: absolute; top: 0; }
  .offers-grid {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 48px;
  }
  .offers-intro {
    position: sticky;
    top: 15vh;
    align-self: start;
  }
  .offers-headline {
    font-size: clamp(2rem, 4.5vw, 4rem);
    line-height: 1.15;
    max-width: 12ch;
  }
  .offers-item { border-top: 1px solid var(--rule-on-dark); }
  .offers-item:last-child { border-bottom: 1px solid var(--rule-on-dark); }

  .offers-summary {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
    padding: 1.75rem 0;
    cursor: pointer;
    list-style: none;
  }
  .offers-summary::-webkit-details-marker { display: none; }
  .offers-summary:focus-visible {
    outline: 2px solid var(--white);
    outline-offset: 4px;
  }
  .offers-titles { display: flex; flex-direction: column; }
  .offers-title {
    font-size: clamp(1.5rem, 2.2vw, 2rem);
    line-height: 1.2;
  }
  .offers-for {
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(1rem, 1.2vw, 1.125rem);
    line-height: 1.4;
    opacity: 0.75;
    margin-top: 0.5rem;
  }
  .offers-chevron {
    flex-shrink: 0;
    width: 1.25rem;
    height: 1.25rem;
    margin-top: 0.4rem;
    transition: transform var(--dur) var(--ease-std);
  }
  .offers-item[open] .offers-chevron { transform: rotate(180deg); }

  .offers-body { padding-bottom: 1.75rem; }
  .offers-body p {
    font-size: clamp(1rem, 1.2vw, 1.0625rem);
    line-height: 1.6;
    opacity: 0.9;
    margin: 0;
  }
  .offers-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    margin-top: 0.5rem;
    font-weight: 500;
    color: var(--white);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .offers-cta:hover { opacity: 0.8; }
  .offers-cta:focus-visible { outline: 2px solid var(--white); outline-offset: 2px; }

  /* Smooth open/close where supported (progressive enhancement). */
  @supports (interpolate-size: allow-keywords) {
    .offers-item { interpolate-size: allow-keywords; }
    .offers-item::details-content {
      height: 0;
      overflow: hidden;
      transition: height var(--dur) var(--ease-std), content-visibility var(--dur) allow-discrete;
    }
    .offers-item[open]::details-content { height: auto; }
  }
  @media (prefers-reduced-motion: reduce) {
    .offers-chevron,
    .offers-item::details-content { transition: none; }
  }

  @media (max-width: 880px) {
    .offers { padding: 64px 24px; }
    .offers-grid { grid-template-columns: 1fr; gap: 32px; }
    .offers-intro { position: static; }
  }
</style>
